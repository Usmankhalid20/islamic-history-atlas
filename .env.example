# PostgreSQL Database Connection String
# Compatible with local PostgreSQL, Neon Serverless, Supabase, Railway, etc.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/islamic_history_atlas"

# Optional: Next.js environment
NODE_ENV="development"

# OpenRouter API Key for historical synthesis / inquiries (optional)
OPENROUTER_API_KEY="your-openrouter-api-key"

# OpenRouter Model Identifier (default: google/gemini-2.5-flash)
OPENROUTER_MODEL="google/gemini-2.5-flash"

